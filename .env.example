# Path: .env.example
# Purpose: Documentation of the inert VITE_ variables the application reads, with no secrets
# Lines: 18
#
# These values are placeholders, not credentials. Copy this file to `.env` to change either one
# locally: `.env` is git-ignored, this file is committed, and nothing here is required to run.
#
# Only VITE_-prefixed names reach client code, because Vite replaces import.meta.env.VITE_* at
# build time and exposes nothing else; an unprefixed variable here would silently do nothing.
#
# The application runs identically with no `.env` file at all, since both defaults below live in
# src/constants/config.ts, and no secret, key or token belongs in this file or in `.env`.
#
# Product name for the document title and the header brand (reader: src/constants/config.ts).
VITE_APP_NAME=SalesPro
# Simulated latency in ms added to every mock-server response by src/lib/mockServer.ts; tests
# pin it to 0 in code, so lowering it here only speeds up the dev server (default: 120).
VITE_API_LATENCY_MS=120
