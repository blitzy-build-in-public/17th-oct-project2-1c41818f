# Path: .gitignore
# Purpose: Ignored paths: installed dependencies, build output and local environment files
# Lines: 36

# Dependencies
node_modules/
# package-lock.json and generation-manifest.md are committed deliverables, deliberately not ignored.

# Build output
dist/
dist-ssr/

# Test and coverage output
coverage/

# Local environment files; .env.example stays tracked as the documented, inert template
.env
.env.local
.env.*.local
*.local

# Logs and tooling caches
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
.eslintcache

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
