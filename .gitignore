# Path: .gitignore
# Purpose: Ignored paths: installed dependencies, build output and local environment files
# Lines: 41

# Dependencies
node_modules/
# generation-manifest.md is a committed deliverable, deliberately not ignored.
# package-lock.json is generated by npm install and left untracked, not a committed deliverable here.

# Build output
dist/
dist-ssr/

# Test and coverage output
coverage/

# Local environment files, including the .env.<mode> files Vite reads for the dev, build and test
# modes this project runs; .env.example stays tracked as the documented, inert template
.env
.env.local
.env.development
.env.production
.env.test
.env.*.local
*.local

# Logs and tooling caches
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.vite/
.eslintcache

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
